
import numpy as np
import matplotlib.pyplot as plt
import math

# --------------------------------
# 1. Define the Problem
# --------------------------------

# Objective: Minimize the weight of a steel beam

density = 7850       # Steel density (kg/m^3)
length = 5.0         # Beam length (m)
min_area = 0.015     # Minimum cross-sectional area (m^2)

# Design variables:
# x[0] = Beam width
# x[1] = Beam height

lower = np.array([0.05, 0.10])
upper = np.array([0.30, 0.50])

def fitness(x):
    width, height = x
    area = width * height

    if area < min_area:
        return 1e6 + (min_area - area) * 1e8

    weight = density * length * area

    return weight


# --------------------------------
# 2. Initialize Parameters
# --------------------------------

n = 25                 # Number of nests
pa = 0.25              # Discovery probability
iterations = 100       # Maximum iterations
alpha = 0.01           # Lévy flight step size


# --------------------------------
# 3. Initialize Population
# --------------------------------

nests = np.random.uniform(
    lower, upper, (n, 2)
)

fitness_values = np.array(
    [fitness(x) for x in nests]
)

# Store best solution
best_index = np.argmin(fitness_values)
best_solution = nests[best_index].copy()
best_fitness = fitness_values[best_index]

best_history = []


# --------------------------------
# 4. Lévy Flight Function
# --------------------------------

def levy_flight():
    beta = 1.5

    sigma = (
        math.gamma(1 + beta) *
        math.sin(math.pi * beta / 2) /
        (
            math.gamma((1 + beta) / 2) *
            beta * 2 ** ((beta - 1) / 2)
        )
    ) ** (1 / beta)

    u = np.random.normal(0, sigma, 2)
    v = np.random.normal(0, 1, 2)

    step = u / (np.abs(v) ** (1 / beta))

    return step


# --------------------------------
# 5. Generate New Solutions
# --------------------------------

for t in range(iterations):

    for i in range(n):

        # Generate new solution using Lévy flight
        new_solution = (
            nests[i] + alpha * levy_flight()
        )

        # Apply design variable limits
        new_solution = np.clip(
            new_solution, lower, upper
        )

        new_fitness = fitness(new_solution)

        # Select a random nest
        j = np.random.randint(n)

        # Replace if new solution is better
        if new_fitness < fitness_values[j]:

            nests[j] = new_solution.copy()
            fitness_values[j] = new_fitness


    # --------------------------------
    # 6. Abandon Worst Nests
    # --------------------------------

    abandon = np.random.rand(n) < pa

    for i in range(n):

        if abandon[i]:

            nests[i] = np.random.uniform(
                lower, upper, 2
            )

            fitness_values[i] = fitness(nests[i])


    # --------------------------------
    # 7. Update Best Solution
    # --------------------------------

    current_best_index = np.argmin(fitness_values)

    current_best_fitness = fitness_values[
        current_best_index
    ]

    if current_best_fitness < best_fitness:

        best_fitness = current_best_fitness

        best_solution = nests[
            current_best_index
        ].copy()

    best_history.append(best_fitness)

    print(
        "Iteration:", t + 1,
        "| Best Weight:", round(best_fitness, 4), "kg"
    )


# --------------------------------
# 8. Output Best Solution
# --------------------------------

print("\n========== OPTIMAL BEAM DESIGN ==========")

print("Optimal Beam Width:",
      round(best_solution[0], 4), "m")

print("Optimal Beam Height:",
      round(best_solution[1], 4), "m")

print("Minimum Beam Weight:",
      round(best_fitness, 4), "kg")

print("Cross-sectional Area:",
      round(best_solution[0] * best_solution[1], 6), "m^2")


# --------------------------------
# 9. Plot Convergence Graph
# --------------------------------

plt.figure(figsize=(8, 5))

plt.plot(
    range(1, iterations + 1),
    best_history,
    color='blue',
    linewidth=2
)

plt.xlabel("Number of Iterations")
plt.ylabel("Minimum Beam Weight (kg)")

plt.title(
    "Cuckoo Search - Structural Design Optimization"
)

plt.grid(True)
plt.show()
